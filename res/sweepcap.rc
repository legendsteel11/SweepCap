#include <windows.h>
#include "resource.h"
#include "../src/app_name.h"

/////////////////////////////////////////////////////////////////////////////
// Manifest: Per-Monitor V2, asInvoker, comctl32 v6
CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "sweepcap.manifest"

/////////////////////////////////////////////////////////////////////////////
// Icon. Generated by tools/make_icon.ps1, not drawn by hand.
IDI_APPICON ICON "sweepcap.ico"

/////////////////////////////////////////////////////////////////////////////
// User-visible strings.
//
// A second language is added as another STRINGTABLE under its own LANGUAGE
// block; LoadString then picks by the thread UI language. Keep the identifiers
// identical across blocks.

LANGUAGE LANG_KOREAN, SUBLANG_DEFAULT

STRINGTABLE
BEGIN
    IDS_TRAY_TIP     SWEEPCAP_NAME
    IDS_MENU_RESTART "다시 시작"
    IDS_MENU_EXIT    "종료"
    IDS_ERR_TRAY   "트레이 아이콘을 등록하지 못했습니다."
    IDS_ERR_HOOK   "마우스 훅을 설치하지 못했습니다.\n영역 캡처가 동작하지 않습니다."

    IDS_MENU_OPEN_FOLDER    "캡처 폴더 열기"
    IDS_MENU_GESTURE        "단축키 변경"
    IDS_MENU_GRID           "캡처 격자"
    IDS_MENU_FOLDER         "저장 폴더"
    IDS_MENU_FOLDER_CHANGE  "변경..."
    IDS_MENU_FOLDER_DEFAULT "기본 저장 폴더로 복원"
    IDS_MENU_FOLDER_NO_DATE "날짜 폴더 생성 안 함"
    IDS_MENU_STARTUP        "부팅 시 시작"
    IDS_FOLDER_PICK_TITLE   "캡처를 저장할 폴더 선택"
    IDS_ERR_STARTUP         "부팅 시 시작을 변경하지 못했습니다."

    IDS_ERR_CAPTURE_TITLE   "캡처 실패"
    IDS_ERR_SAVE_ONLY       "파일로 저장하지 못했습니다. 클립보드에는 복사되었습니다."
    IDS_ERR_CLIP_ONLY       "클립보드에 복사하지 못했습니다. 파일로는 저장되었습니다."
    IDS_ERR_DELIVERY_ALL    "저장과 클립보드 복사가 모두 실패했습니다."
    IDS_ERR_CAPTURE_NONE    "캡처 이미지를 만들지 못했습니다."

    IDS_GRID_DIVISIONS      "%d x %d 분할"

    IDS_MENU_DIM            "바깥 어둡게"
    IDS_MENU_WINDOW_GRID    "창 격자"
    IDS_DIM_OFF             "끔"
    IDS_DIM_LIGHT           "약하게"
    IDS_DIM_NORMAL          "보통"
    IDS_DIM_STRONG          "진하게"

    IDS_MENU_ABOUT          "앱 정보"
    IDS_ABOUT_AUTHOR        "제작자: " SWEEPCAP_AUTHOR_EMAIL
    IDS_ABOUT_AUTHOR_COPIED "제작자: " SWEEPCAP_AUTHOR_EMAIL " (복사되었습니다)"
    IDS_ABOUT_COPY_EMAIL    "이메일 주소 복사"
    IDS_ABOUT_GITHUB     "GitHub: <a href=""https://github.com/legendsteel11"">github.com/legendsteel11</a>"
    IDS_ABOUT_THIRDPARTY "이 앱은 Microsoft WIL(MIT 라이선스)을 포함합니다."

    IDS_GESTURE_CTRL_ALT       "Ctrl+Alt (+Shift: 격자 스냅)"
    IDS_GESTURE_CTRL_WIN       "Ctrl+Win (+Shift: 격자 스냅)"
    IDS_GESTURE_ALT_WIN        "Alt+Win (+Shift: 격자 스냅)"
    IDS_GESTURE_CTRL_ALT_WIN   "Ctrl+Alt+Win (+Shift: 격자 스냅)"
    IDS_GESTURE_CTRL_SHIFT_WIN "Ctrl+Shift+Win (+Alt: 격자 스냅)"
END

// English. LoadString picks the block by the thread UI language, so this is
// what every non-Korean Windows shows. Keep the identifiers in step with the
// Korean block above.

LANGUAGE LANG_ENGLISH, SUBLANG_ENGLISH_US

STRINGTABLE
BEGIN
    IDS_TRAY_TIP     SWEEPCAP_NAME
    IDS_MENU_RESTART "Restart"
    IDS_MENU_EXIT    "Exit"
    IDS_ERR_TRAY   "Could not register the tray icon."
    IDS_ERR_HOOK   "Could not install the mouse hook.\nRegion capture is disabled."

    IDS_MENU_OPEN_FOLDER    "Open capture folder"
    IDS_MENU_GESTURE        "Change shortcut"
    IDS_MENU_GRID           "Capture grid"
    IDS_MENU_FOLDER         "Save folder"
    IDS_MENU_FOLDER_CHANGE  "Change..."
    IDS_MENU_FOLDER_DEFAULT "Restore the default folder"
    IDS_MENU_FOLDER_NO_DATE "No date subfolders"
    IDS_MENU_STARTUP        "Run at startup"
    IDS_FOLDER_PICK_TITLE   "Choose where captures are saved"
    IDS_ERR_STARTUP         "Could not change the startup entry."

    IDS_ERR_CAPTURE_TITLE   "Capture failed"
    IDS_ERR_SAVE_ONLY       "Could not save to a file. The capture was copied to the clipboard."
    IDS_ERR_CLIP_ONLY       "Could not copy to the clipboard. The capture was saved to a file."
    IDS_ERR_DELIVERY_ALL    "Saving to a file and copying to the clipboard both failed."
    IDS_ERR_CAPTURE_NONE    "Could not produce the capture image."

    IDS_GRID_DIVISIONS      "%d x %d divisions"

    IDS_MENU_DIM            "Dim outside"
    IDS_MENU_WINDOW_GRID    "Window grid"
    IDS_DIM_OFF             "Off"
    IDS_DIM_LIGHT           "Light"
    IDS_DIM_NORMAL          "Normal"
    IDS_DIM_STRONG          "Strong"

    IDS_MENU_ABOUT          "About"
    IDS_ABOUT_AUTHOR        "Author: " SWEEPCAP_AUTHOR_EMAIL
    IDS_ABOUT_AUTHOR_COPIED "Author: " SWEEPCAP_AUTHOR_EMAIL " (copied)"
    IDS_ABOUT_COPY_EMAIL    "Copy email address"
    IDS_ABOUT_GITHUB     "GitHub: <a href=""https://github.com/legendsteel11"">github.com/legendsteel11</a>"
    IDS_ABOUT_THIRDPARTY "This application includes Microsoft WIL (MIT License)."

    IDS_GESTURE_CTRL_ALT       "Ctrl+Alt (+Shift: grid snap)"
    IDS_GESTURE_CTRL_WIN       "Ctrl+Win (+Shift: grid snap)"
    IDS_GESTURE_ALT_WIN        "Alt+Win (+Shift: grid snap)"
    IDS_GESTURE_CTRL_ALT_WIN   "Ctrl+Alt+Win (+Shift: grid snap)"
    IDS_GESTURE_CTRL_SHIFT_WIN "Ctrl+Shift+Win (+Alt: grid snap)"
END

/////////////////////////////////////////////////////////////////////////////
// Version
VS_VERSION_INFO VERSIONINFO
 FILEVERSION    SWEEPCAP_VER_COMMA
 PRODUCTVERSION SWEEPCAP_VER_COMMA
 FILEFLAGSMASK  VS_FFI_FILEFLAGSMASK
#ifdef _DEBUG
 FILEFLAGS      VS_FF_DEBUG
#else
 FILEFLAGS      0x0L
#endif
 FILEOS         VOS_NT_WINDOWS32
 FILETYPE       VFT_APP
 FILESUBTYPE    VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "041204B0"
        BEGIN
            VALUE "FileDescription",  SWEEPCAP_NAME
            VALUE "FileVersion",      SWEEPCAP_VERSION
            VALUE "LegalCopyright",   "Copyright (c) 2026 " SWEEPCAP_AUTHOR_EMAIL
            VALUE "InternalName",     SWEEPCAP_NAME
            VALUE "OriginalFilename", SWEEPCAP_NAME ".exe"
            VALUE "ProductName",      SWEEPCAP_NAME
            VALUE "ProductVersion",   SWEEPCAP_VERSION
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x412, 1200
    END
END